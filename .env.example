# Environment variables for E-Waste Collector Platform

# Database (MongoDB 7+ with Replica Set rs0)
# Local Docker Replica Set:
DATABASE_URL="mongodb://localhost:27017/ewaste?replicaSet=rs0&directConnection=true"
# Production (MongoDB Atlas):
# DATABASE_URL="mongodb+srv://<user>:<password>@cluster0.mongodb.net/ewaste?retryWrites=true&w=majority"

# Authentication & JWT Secrets
JWT_SECRET="super-secret-jwt-key-minimum-32-chars-long-collector-token"
SESSION_SECRET="super-secret-session-cookie-key-for-recycler-and-admin-32-chars"

# Cron API Authorization
CRON_SECRET="platform-cron-secret-token-for-maintenance-tasks"

# Storage Driver: "local" (default for dev) or "s3" (AWS / MinIO / Supabase)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"

# S3 Compatible Storage Config (Used when STORAGE_DRIVER="s3" e.g., MinIO/AWS/Supabase)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="ewaste-media"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# Seeding Flags
SEED_SAMPLE_DATA="true"

# Server Port
PORT=3000
